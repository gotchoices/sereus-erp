{
  "name": "@wyatt/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "WYATT_SEED=${WYATT_SEED:-sample} vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "echo \"no web tests yet\"",
    "start": "node build",
    "dev:mock": "WYATT_DATA=memory vite dev",
    "dev_loop": "scripts/dev-loop.sh",
    "import:ati": "node scripts/import-ati.ts",
    "dev:ati": "WYATT_HOME=../../data/wyatt-ati WYATT_SEED=none WYATT_LABEL='ATI 2014 test data' scripts/dev-loop.sh 5175",
    "app": "WYATT_SEED=none WYATT_HOME=${WYATT_HOME:-$HOME/.wyatt-web} vite dev --port ${PORT:-5180} --strictPort"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^24.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "type": "module",
  "dependencies": {
    "@libp2p/circuit-relay-v2": "4.2.14",
    "@libp2p/websockets": "10.1.22",
    "@optimystic/db-p2p-storage-fs": "1.27.0",
    "@quereus/quereus": "5.4.0",
    "@serfab/cadre-core": "1.22.0",
    "@wyatt/core": "workspace:^",
    "@wyatt/domain": "workspace:^",
    "@wyatt/node": "workspace:^"
  }
}
