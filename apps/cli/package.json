{
  "name": "@wyatt/cli",
  "version": "0.0.0",
  "private": true,
  "description": "The wyatt command: set up and run a WyattERP machine (a server, or any machine without a browser), and manage the installation.",
  "type": "module",
  "main": "./dist/main.js",
  "bin": {
    "wyatt": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@wyatt/core": "workspace:^",
    "@wyatt/node": "workspace:^",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
