{
  "name": "@wyatt/bom-engine",
  "version": "0.0.0",
  "private": true,
  "description": "The parametric BOM engine: pure, deterministic explosion of catalog definitions (docs/specs/bom-engine.md).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
