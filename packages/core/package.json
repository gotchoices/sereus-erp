{
  "name": "@wyatt/core",
  "version": "0.0.0",
  "private": true,
  "description": "Per-module strand control logic: schemas, queries, transitions, outbox and poster. Handed a running Sereus node; never builds one.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@wyatt/bom-engine": "workspace:^",
    "@wyatt/domain": "workspace:^"
  },
  "devDependencies": {
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@libp2p/circuit-relay-v2": "4.2.14",
    "@libp2p/crypto": "5.1.24",
    "@libp2p/identify": "4.1.15",
    "@libp2p/websockets": "10.1.22",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.2.0",
    "@optimystic/db-p2p": "1.25.0",
    "@quereus/quereus": "4.25.0",
    "@serfab/cadre-core": "1.21.0",
    "@types/node": "^24.0.0",
    "libp2p": "3.3.11",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "peerDependencies": {
    "@quereus/quereus": "^4.25.0",
    "@serfab/cadre-core": "^1.21.0"
  }
}
