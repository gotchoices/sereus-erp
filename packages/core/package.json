{
  "name": "@wyatt/core",
  "version": "0.0.0",
  "private": true,
  "description": "Per-module strand control logic: schemas, queries, transitions, outbox and poster. Handed a running Sereus node; never builds one.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@wyatt/bom-engine": "workspace:^",
    "@wyatt/domain": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
